[Unit]
Description=One-way sync: Immich originals -> Google Drive (gdrive:Immich Library)
Documentation=https://rclone.org/commands/rclone_sync/
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=wbw
Group=wbw

# Be gentle so Plex etc. keep priority
Nice=15
IOSchedulingClass=idle

# /bigdisk/immich/library/upload/<user-uuid> is Immich's originals store for
# the single account on this host (media/immich.yml mounts the parent
# directory at /data). The thumbs/, encoded-video/ and backups/ siblings are
# regenerable and deliberately not synced. The pull sync excludes
# "Immich Library" so this push is one-way (see rclone-gdrive-sync.service).
#
# --max-delete=100 guards against a moved/renamed library wiping the drive
# copy. --drive-stop-on-upload-limit ends a run cleanly at Google's daily
# upload quota (~750 GiB/day) instead of retrying past it; the next timer
# run resumes where this one stopped.
ExecStart=/home/wbw/.local/bin/rclone sync /bigdisk/immich/library/upload/ffb64a21-1742-43ee-aeb0-4e54c488de9c "gdrive:Immich Library" \
    --config=/home/wbw/.config/rclone/rclone.conf \
    --fast-list \
    --transfers=8 \
    --checkers=16 \
    --track-renames \
    --max-delete=100 \
    --drive-stop-on-upload-limit \
    --retries=3 \
    --low-level-retries=10 \
    --log-level=INFO

# No [Install] section on purpose: this unit is triggered only by
# rclone-immich-push.timer, never enabled/started directly.
