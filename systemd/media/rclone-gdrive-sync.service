[Unit]
Description=One-way sync: Google Drive -> /bigdisk/google-drive
Documentation=https://rclone.org/commands/rclone_sync/
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=wbw
Group=wbw

# Be gentle so Plex etc. keep priority
Nice=15
IOSchedulingClass=idle

# "Immich Library" on the drive is written by rclone-immich-push.service;
# the exclude keeps this pull from copying that mirror back down onto
# /bigdisk/google-drive.
ExecStart=/home/wbw/.local/bin/rclone sync gdrive: /bigdisk/google-drive \
    --config=/home/wbw/.config/rclone/rclone.conf \
    --fast-list \
    --transfers=8 \
    --checkers=16 \
    --track-renames \
    --create-empty-src-dirs \
    --max-delete=500 \
    --exclude "Immich Library/**" \
    --retries=3 \
    --low-level-retries=10 \
    --log-level=INFO

# No [Install] section on purpose: this unit is triggered only by
# rclone-gdrive-sync.timer, never enabled/started directly.
