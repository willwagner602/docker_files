# Safe placeholders for Compose validation and local setup. Copy to unpoller.env,
# then replace the controller credentials and Grafana password before deploying.
# NOTE: uni-live/uni-analytics authenticate to the same controller with
# UNIFI_PASSWORD from general/.env — rotate BOTH files together (see .env.example)
# or unpoller's ingestion silently stops while they keep working.
UP_UNIFI_CONTROLLER_0_URL=https://10.0.0.16:8443
UP_UNIFI_CONTROLLER_0_VERIFY_SSL=false
UP_UNIFI_CONTROLLER_0_USER=REPLACE_ME
UP_UNIFI_CONTROLLER_0_PASS=REPLACE_ME
UP_UNIFI_CONTROLLER_0_SITE=default
UP_INFLUXDB_URL=http://unifi-influxdb:8086
UP_INFLUXDB_DB=unifi
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=REPLACE_ME
