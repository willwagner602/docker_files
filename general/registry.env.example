# Template for the local docker registry env file (registry.yml).
# Copy to registry.env and replace the value; registry.env is gitignored like
# the other *.env files.
#
#   REGISTRY_HTTP_SECRET — random secret the registry signs upload-state
#                          tokens with: openssl rand -hex 32
#
# Related (not in this env file):
#   registry.htpasswd — per-user credential file the nginx auth front mounts;
#     create with: printf '%s:\n' 'user:'"$(openssl passwd -apr1)" >
#     general/registry.htpasswd (chmod 600, never commit).
#   Woodpecker secret REGISTRY_PASSWORD — same plaintext password used in the
#     htpasswd file, referenced by .woodpecker/publish.yml in repos that push
#     here (currently TaxCalculator). User name is fixed there as
#     REGISTRY_USERNAME.
REGISTRY_HTTP_SECRET=CHANGE_ME_openssl_rand_hex_32
