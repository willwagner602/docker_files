# general stack — environment template.
#
# Usage:
#   cp general/.env.example general/.env   # then replace every value below
#
# Compose reads .env from THIS directory (general/), not the repo root.
#
# The values below are deliberately non-empty placeholders. Compose treats an
# empty value as "not set" for `${VAR:?}` requirements, so leaving any of these
# blank makes `docker compose config` fail with a "missing a value" error.
# Replace them all with real values before deploying.
#
# NOTE: this file is tracked by git. Never put real secrets here — put those in
# general/.env, which is gitignored.

# --- required by general/health-notify-general.yml --------------------------
# Telegram bot token and chat id used to deliver health alerts.
# Create a bot with @BotFather to get the token; the chat id is the destination
# channel/group id.
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME

# --- required by general/couchdb.yml ---------------------------------------
# Admin credentials for CouchDB. Both are required; CouchDB only honours the
# password on first initialisation of an empty data directory (it comes from
# /home/wbw/couchdb/etc/local.d), so changing it later needs a manual reset.
COUCHDB_USER=REPLACE_ME
COUCHDB_PASSWORD=REPLACE_ME

# --- required by general/pihole.yml ----------------------------------------
# Pi-hole web admin password, set via FTLCONF_webserver_api_password.
# The value previously hard-coded in general/pihole.yml was committed to git
# and must be considered compromised — pick a NEW password here, do not reuse it.
PIHOLE_WEBPASSWORD=REPLACE_ME

# --- required by general/unifi.yml -----------------------------------------
# MongoDB credentials for the UniFi controller's database.
# MONGO_INITDB_ROOT_PASSWORD seeds the root account on FIRST initialisation only
# (it is ignored once the data directory exists). MONGO_PASS is the password for
# the non-root `unifi` application user and must match between unifi-db and
# unifi-controller.
# Both values were previously hard-coded as `password` and must be treated as
# compromised — choose new ones.
MONGO_INITDB_ROOT_PASSWORD=REPLACE_ME
MONGO_PASS=REPLACE_ME

# --- required by general/zwavejsui.yml -------------------------------------
# Session secret for the Z-Wave JS UI web interface. Any random string works;
# generate one with: openssl rand -hex 32
# The previous hard-coded value (`mysupersecretkey`) was committed to git and
# must be treated as compromised.
ZWAVE_SESSION_SECRET=REPLACE_ME

# --- required by general/komodo.yml ----------------------------------------
# Credentials for Komodo's own MongoDB (any username, strong password).
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=REPLACE_ME
# Initial admin login for the Komodo UI (http://<host>:9120), created on first
# launch only.
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=REPLACE_ME
# Random secrets for JWT signing and webhook auth: openssl rand -hex 24
KOMODO_JWT_SECRET=REPLACE_ME
KOMODO_WEBHOOK_SECRET=REPLACE_ME

# --- required by general/mindwtr.yml ---------------------------------------
# Mindwtr sync server access token. Generate one with: openssl rand -hex 32
#
# The token IS the account: it is hashed to the dataset filename, so every
# device you want to sync must use the same token, and a different token means
# a different dataset rather than a second key for the same one. To rotate it,
# change the value here and recreate the container; existing data is keyed by
# the old token's hash and will not be reachable under a new one.
MINDWTR_CLOUD_AUTH_TOKENS=REPLACE_ME

# Origin allowed to call the API from a browser. The server refuses to start
# with "*". The native desktop and mobile apps do not send an Origin header, so
# this value does not affect them; it only matters for the optional web build.
MINDWTR_CLOUD_CORS_ORIGIN=https://mindwtr.willwagner.me

# --- required by general/uni-analytics.yml and general/uni-live.yml -----------
# Read-only local UniFi account for the migration snapshot/live view.
# The existing unifi-mcp account works; a dedicated read-only account is fine too.
# UNIFI_HOST: use the split-horizon LAN name (unifi.willwagner.me resolves to
# 10.0.0.16 via Pi-hole) so containers skip the WAN hairpin; UNIFI_PORT 443 goes
# through nginx-proxy with its Let's Encrypt cert, so TLS verification works.
UNIFI_HOST=unifi.willwagner.me
UNIFI_PORT=443
UNIFI_USERNAME=unifi-mcp
# NOTE: the unpoller monitoring stack (general/unpoller.yml) authenticates to
# the same controller with UP_UNIFI_CONTROLLER_0_USER/_PASS from unpoller.env
# — rotate BOTH files together or unpoller's ingestion silently stops while
# uni-live keeps working (they are separate secret stores by design; see the
# README UniFi section).
UNIFI_PASSWORD=REPLACE_ME

# --- optional: general/mindwtr.yml -----------------------------------------
# Leave both blank unless you have pinned Nginx Proxy Manager's address on the
# mindwtr-net network. These control per-client-IP auth-failure throttling and
# log attribution only; they have no effect on whether a token is authorized.
# MINDWTR_CLOUD_TRUST_PROXY_HEADERS=false
# MINDWTR_CLOUD_TRUSTED_PROXY_IPS=
