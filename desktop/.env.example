# desktop stack — environment template.
#
# Usage:
#   cp desktop/.env.example desktop/.env   # then replace every value below
#
# Compose reads .env from THIS directory (desktop/), not the repo root.
#
# The values below are deliberately non-empty placeholders. Compose treats an
# empty value as "not set" for `${VAR:?}` requirements, so leaving any of these
# blank makes `docker compose config` fail with a "missing a value" error.
# Replace them all with real values before deploying.
#
# NOTE: this file is tracked by git. Never put real secrets here — put those in
# desktop/.env, which is gitignored.

# --- required by desktop/komodo-mcp.yml -------------------------------------
# Komodo Core's API endpoint as seen from this machine. Komodo Core runs in the
# general stack, so this is that host's address and port.
KOMODO_URL=...

# Komodo API key and secret used for read-only access. Create the key in the
# Komodo UI (Settings -> API Keys). Komodo keys carry no permissions of their
# own, so a key is only as narrow as the grants attached to it — verify what a
# key can actually do with `sh scripts/komodo-probe.sh` rather than assuming.
KOMODO_API_KEY=...
KOMODO_API_SECRET=...

# --- optional: desktop/komodo-mcp.yml ---------------------------------------
# Tool filtering. The defaults in komodo-mcp.yml produce the read-only tool list
# documented in README.md; only set these to narrow it further.
# MCP_TOOLS_ALLOWED_CATEGORIES=...
# MCP_TOOLS_EXCLUDED_TOOLS=...
