# desktop stack — environment template.
# Copy to desktop/.env and replace the required Komodo values before starting
# Compose services. This tracked file contains placeholders only; never add
# secrets here.

# Required by desktop/mcp-servers/komodo-mcp.yml
KOMODO_URL=...
KOMODO_API_KEY=...
KOMODO_API_SECRET=...

# Optional credentials for MCP clients. These are not automatically loaded by
# Polytoken; export needed variables in its process environment. HA_TOKEN must
# also be set as auth.value: "Bearer <token>" in the Home Assistant entry in
# ~/.config/polytoken/config.yaml; this template does not interpolate it there.
HA_TOKEN=...
UNIFI_HOST=...
UNIFI_USERNAME=...
UNIFI_PASSWORD=...
PIHOLE_URL=...
PIHOLE_PASSWORD=...
FRIGATE_URL=...
