# desktop stack — environment template.
# Copy to desktop/.env and replace the required Komodo values before starting
# Compose services. This tracked file contains placeholders only; never add
# secrets here.

# Required by desktop/mcp-servers/komodo-mcp.yml
KOMODO_URL=...
KOMODO_API_KEY=...
KOMODO_API_SECRET=...

# Optional credentials for MCP clients. These are not automatically loaded by
# Polytoken; export needed variables in its process environment. HA_TOKEN must
# also be set as auth.value: "Bearer <token>" in the Home Assistant entry in
# ~/.config/polytoken/config.yaml; this template does not interpolate it there.
HA_TOKEN=...
UNIFI_HOST=...
UNIFI_USERNAME=...
UNIFI_PASSWORD=...
PIHOLE_URL=...
PIHOLE_PASSWORD=...
FRIGATE_URL=...
# Required by the obsidian client fragment (desktop/mcp-servers/obsidian.yaml):
# the Obsidian Local REST API plugin key. Export it in the Polytoken process
# environment (step 5 of "Set up the desktop MCP servers"); Compose does not
# read it from this file.
OBSIDIAN_API_KEY=...

# KOMODO_* placeholders are kept non-empty deliberately — make validate copies
# this file to .env and komodo-mcp.yml's ${VAR:?} lines fail on an empty value.
