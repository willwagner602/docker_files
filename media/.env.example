# media stack — environment template.
#
# Usage:
#   cp media/.env.example media/.env   # then replace every value below
#
# Compose reads .env from THIS directory (media/), not the repo root.
#
# The values below are deliberately non-empty placeholders. Compose treats an
# empty value as "not set" for `${VAR:?}` requirements, so leaving any of these
# blank makes `docker compose config` fail with a "missing a value" error.
# Replace them all with real values before deploying.
#
# NOTE: this file is tracked by git. Never put real secrets here — put those in
# media/.env, which is gitignored.
#
# Variables with a `:-default` in the compose files (LOG_LEVEL, CAPTCHA_SOLVER,
# IMMICH_PORT, etc.) are optional and intentionally omitted here; uncomment if
# you want to override them.

# --- required by media/komodo.yml (optional with defaults) --------------------
# Outbound connection to Komodo Core on general. Only PERIPHERY_ONBOARDING_KEY
# must be filled in: create it in the Core UI (Settings / Onboarding) with
# privileged mode enabled, then `docker compose up -d komodo-periphery`.
#PERIPHERY_CORE_ADDRESS=ws://10.0.0.16:9120
#PERIPHERY_CONNECT_AS=media
PERIPHERY_ONBOARDING_KEY=

# --- required by media/health-notify-media.yml ------------------------------
# Telegram bot token and chat id used to deliver health alerts.
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME

# --- required by media/immich.yml ------------------------------------------
# Immich image tag. Pin a specific release rather than tracking latest.
IMMICH_VERSION=REPLACE_ME
# Password for the Immich Postgres database.
IMMICH_DB_PASSWORD=REPLACE_ME

# --- required by media/photo-uploader.yml ----------------------------------
PHOTO_UPLOADER_OPERATOR_USERNAME=REPLACE_ME
PHOTO_UPLOADER_OPERATOR_PASSWORD=REPLACE_ME
# Session signing secret; must be at least 32 bytes.
PHOTO_UPLOADER_SESSION_SECRET=REPLACE_ME
PHOTO_UPLOADER_BSKY_HANDLE=REPLACE_ME
PHOTO_UPLOADER_BSKY_APP_PASSWORD=REPLACE_ME
# Host directory holding the photos to upload (mounted read-only at /photos).
PHOTO_UPLOADER_PHOTO_PATH=/path/to/photos

# --- API keys consumed by the health-notify role (optional but recommended) --
# The media health-notify role uses these for its *arr / SAB health checks.
# Compose interpolates them as blanks if unset, so they are not required for
# `docker compose config`, but the corresponding checks stay silent without them.
SONARR_API_KEY=
RADARR_API_KEY=
SAB_API_KEY=
PLUS_API_KEY=
FRIGATE_RTSP_PASSWORD=

# --- required by media/plex.yml --------------------------------------------
# Claim token that binds this Plex container to your Plex account. Fetch a fresh
# one from https://plex.tv/claim just before the first `up`. It is single-use and
# expires a few minutes after issue, so after the server is claimed you can leave
# this as-is (or blank out media/.env) — it is only read on first startup.
PLEX_CLAIM=REPLACE_ME

# --- required by media/postgres.yml ----------------------------------------
POSTGRES_PASSWORD=REPLACE_ME

# --- required by media/qbittorrent.yml and media/sabnzbd.yml -----------------
# PIA VPN credentials for the download clients.
PIA_USER=REPLACE_ME
PIA_PASS=REPLACE_ME
